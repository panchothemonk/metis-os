{
  "name": "obsidian-metis-os",
  "version": "1.0.0",
  "description": "MetisOS Obsidian plugin — consciousness OS for your vault",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": ["obsidian", "metisos", "ai", "memory", "knowledge-graph"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "obsidian": "latest",
    "typescript": "^5.0.0",
    "esbuild": "^0.19.0",
    "builtin-modules": "^3.3.0"
  }
}
